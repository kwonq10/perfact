# 内部資料・作業用ディレクトリ（本番公開対象外）
docs/
marketing/

# Chrome Web Store 提出用の中間生成物
chrome-web-store/packages/
chrome-web-store/screenshots-1280x800-rgb/

# Supabase CLI のローカルキャッシュ（リンク状態・バージョン情報）
supabase/.temp/

# Node 依存（Cloudflare Pages Functions 用）
node_modules/
.wrangler/

# wrangler のローカル変数（秘密値を含むため絶対に commit しない）
.dev.vars
.dev.vars.*
# 変数名と説明だけのテンプレートは共有する（値は書かない）
!.dev.vars.example

# 汎用の env ファイルも誤 commit を防ぐ（現状は未使用）
.env
.env.*
